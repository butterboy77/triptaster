# Copy to .env and edit. Only BASE_URL is required.

# The address people type to reach TripTaster. Installing it as an app needs https.
BASE_URL=https://food.example.com

# Set to true when running behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik...),
# so repeated failed sign-ins are tracked per visitor rather than per proxy.
TRUST_PROXY=false

# Username and password sign-in. Turn off for single sign-on only.
PASSWORD_LOGIN=true

# Optional single sign-on through any OpenID Connect provider
# (Pocket ID, Authentik, Authelia, Keycloak, Google...).
# Register the callback URL <BASE_URL>/auth/oidc/callback with your provider.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Pocket ID
# Let anyone your provider signs in get an account, without an invite:
# OIDC_AUTO_REGISTER=false
# Only allow members of these groups (comma separated), read from the "groups" claim:
# OIDC_ALLOWED_GROUPS=
